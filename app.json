{
  "expo": {
    "name": "Murimi",
    "slug": "Murimi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/murimi-icon-light.png",
    "scheme": "murimi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/murimi-icon-light.png",
        "dark": "./assets/images/murimi-icon-dark.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7FBF5",
        "foregroundImage": "./assets/images/murimi-android-foreground.png",
        "monochromeImage": "./assets/images/murimi-android-monochrome.png"
      },
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "package": "com.armament.murimi"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/murimi-icon-light.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/murimi-splash-light.png",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/murimi-splash-dark.png"
          },
          "imageWidth": 180
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/analytics",
      "expo-image",
      "expo-web-browser",
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f99d3e3f-6b74-4242-97fe-1b0de27de5d7"
      }
    }
  }
}
